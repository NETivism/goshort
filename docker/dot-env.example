# Authentication type: leave unset for HTTP Basic Auth, or set to "apikey" for API Key Auth
#AUTH_TYPE=apikey

# HTTP Basic Auth credentials (required when AUTH_TYPE is not "apikey")
AUTH_USERNAME=http_basic_auth_name
AUTH_PASSWORD=http_basic_auth_password

# API Key Auth (required when AUTH_TYPE=apikey)
#AUTH_APIKEY=your_api_key_here

# http server listen post, required
LISTEN_PORT=33512

# sqlite
DATABASE_TYPE=sqlite
DATABASE_NAME=goshort

# mysql / pgsql further support(currently not available)
#DATABASE_HOST=
#DATABASE_PORT=
#DATABASE_USER=
#DATABASE_PASSWORD=

# Migrate Database from boltdb sqlite
DATABASE_MIGRATE=false

# Timezone for date grouping in visit statistics (IANA timezone name)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# Defaults to UTC if unset or invalid
TIMEZONE=Asia/Taipei

# Hourly breakdown threshold for visit statistics.
# 0 = disabled (never show hourly), 1 = always show hourly,
# N > 1 = show hourly only when daily visits exceed N. Defaults to 10.
#VISITS_HOURLY_THRESHOLD=10